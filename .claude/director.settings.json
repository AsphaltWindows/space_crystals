{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/notify_new.py\" artifacts/designer/changes \"\" artifacts/director/state/last_seen_change \"Design changes\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/notify_new.py\" artifacts/designer/changes \"\" artifacts/director/state/last_seen_change \"Design changes\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/notify_new.py\" artifacts/designer/changes \"\" artifacts/director/state/last_seen_change \"Design changes\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
